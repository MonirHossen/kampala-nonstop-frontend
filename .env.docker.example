# Kampala Nonstop Frontend — Docker environment
# Copy to .env.docker: cp .env.docker.example .env.docker

COMPOSE_PROJECT_NAME=kampala-nonstop-frontend

# Development (ng serve)
FRONTEND_DEV_PORT=4201

# Production (nginx static build)
FRONTEND_PORT=8080

# Browser calls to the API use src/environments/environment.ts → apiUrl
# (default http://localhost:8010/api/v1). That port MUST equal
# kampala-nonstop-api/.env.docker APP_PORT. If you change APP_PORT, update
# environment.ts too, then run: make -C .. check-config
